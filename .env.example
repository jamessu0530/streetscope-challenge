GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

FACEBOOK_APP_ID=your_facebook_app_id
# Limited Login JWT 簽章驗證失敗時的課堂用後備（正式環境請設 false）
FACEBOOK_LIMITED_LOGIN_RELAXED=true

# AI 對戰 — Gemini 看圖猜經緯度（去 https://aistudio.google.com/apikey 申請）
GEMINI_API_KEY=your_gemini_api_key
# 可選：預設 gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas — 後端專用（勿放進 Flutter 直連）
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority

JWT_SECRET=your-random-secret-at-least-32-chars
API_BASE_URL=http://localhost:3000
PASSWORD_RESET_EXPOSE_TOKEN=true
PASSWORD_RESET_EXPIRE_MINUTES=60
