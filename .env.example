GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

FACEBOOK_APP_ID=your_facebook_app_id

# GitHub OAuth — https://github.com/settings/developers 建立 OAuth App
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# 須與 GitHub App 的 Authorization callback URL、iOS Info.plist URL Scheme 一致
GITHUB_OAUTH_REDIRECT_URI=com.example.geoGuesser://github-callback
# Limited Login JWT 簽章驗證失敗時的課堂用後備（正式環境請設 false）
FACEBOOK_LIMITED_LOGIN_RELAXED=true

# AI 對戰 — Gemini 看圖猜經緯度（去 https://aistudio.google.com/apikey 申請）
GEMINI_API_KEY=your_gemini_api_key
# 可選：預設 gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas — 後端專用（勿放進 Flutter 直連）
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority

JWT_SECRET=your-random-secret-at-least-32-chars
# 模擬器可用 localhost；真機請改成 Mac 區網 IP（ipconfig getifaddr en0）
# 換 Wi‑Fi 後用：ipconfig getifaddr en0（家裡常為 192.168.1.x，熱點常為 172.20.10.x）
API_BASE_URL=http://192.168.3.116:3000

# 設為 true 時，後端啟動會清空 MongoDB leaderboard_entries（用完請改回 false）
LEADERBOARD_CLEAR_ON_START=false

# 設為 true 時，後端啟動會清空 MongoDB user_memes（用完請改回 false）
MEME_CLEAR_ON_START=false
PASSWORD_RESET_EXPOSE_TOKEN=true
PASSWORD_RESET_EXPIRE_MINUTES=60
